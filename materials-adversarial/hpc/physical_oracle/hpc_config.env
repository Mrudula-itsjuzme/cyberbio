# HPC Configuration for Physical Oracle Workflow
# These are infrastructure recommendations.

MEM_GB=64                     # Recommended 64 GiB for safer convergence exploration; absolute lower bound is 32 GiB.
CPUS_PER_TASK=16
MPI_RANKS=4
WALLTIME="24:00:00"
PARTITION="compute"
ACCOUNT="your_account"
WORKDIR="/path/to/workdir"
